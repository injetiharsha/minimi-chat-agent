# ==============================================================================
# MINIMI CHAT AGENT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Primary LLM Provider: Google Gemini API Key (Required for default provider)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Live Web Search Provider: Tavily API Key (Required for live web verification)
# Get your key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Optional Multi-Provider Keys (Enable alternative providers in the UI popover)
# ------------------------------------------------------------------------------

# OpenAI API Key (Enables GPT-4o, GPT-4o-mini in the model selector)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Enables Claude 3.5 Sonnet in the model selector)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Default Engine Overrides (Optional)
# ------------------------------------------------------------------------------
# Default provider: google | openai | anthropic
LLM_PROVIDER=google

# Default model: gemini-3.5-flash-lite | gemini-flash-lite-latest | gpt-4o | claude-3-5-sonnet-20241022
LLM_MODEL=gemini-3.5-flash-lite

# Search Provider: tavily | mock
SEARCH_PROVIDER=tavily

# Server Port (default: 3000)
PORT=3000

# Optional: Override wall-clock time for deterministic evaluations (ISO format)
# NOW_OVERRIDE=2026-11-14T10:00:00Z
